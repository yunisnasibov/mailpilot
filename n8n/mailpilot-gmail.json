{
  "name": "MailPilot — Gmail triage and human-reviewed drafts",
  "nodes": [
    {
      "id": "Test-Gmail-inbox",
      "name": "Test Gmail inbox",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "maxResults": 5,
        "filters": {
          "q": "in:inbox subject:MailPilot-Test -in:drafts",
          "readStatus": "both"
        },
        "options": {
          "downloadAttachments": false
        }
      }
    },
    {
      "id": "Normalize-email",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m=$json; const f=m.from?.value?.[0]; if(!f?.address) throw new Error('Missing sender address'); return {json:{message_id:m.id,thread_id:m.threadId||'',sender:f.name||f.address,sender_email:f.address,subject:m.subject||'(No subject)',body:(m.text||m.html||'').slice(0,24000),received_at:m.date||''}};"
      }
    },
    {
      "id": "Analyze-and-save",
      "name": "Analyze and save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4175/api/intake/email",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "Reserve-draft",
      "name": "Reserve draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:4175/api/intake/{{ $json.id }}/claim-draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "Needs-Gmail-draft",
      "name": "Needs Gmail draft",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "draft-check",
              "leftValue": "={{ $json.create_draft }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "Create-Gmail-draft",
      "name": "Create Gmail draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1150,
        300
      ],
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ \"Re: \" + $json.email.original.subject }}",
        "emailType": "text",
        "message": "={{ $json.email.draft }}",
        "options": {
          "sendTo": "={{ $json.email.original.sender_email }}",
          "threadId": "={{ $json.email.original.thread_id }}"
        }
      }
    },
    {
      "id": "Record-Gmail-draft",
      "name": "Record Gmail draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:4175/api/intake/{{ $(\"Reserve draft\").item.json.email.id }}/draft-created",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({gmail_draft_id:$json.id}) }}",
        "options": {
          "timeout": 60000
        }
      }
    }
  ],
  "connections": {
    "Test Gmail inbox": {
      "main": [
        [
          {
            "node": "Normalize email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize email": {
      "main": [
        [
          {
            "node": "Analyze and save",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze and save": {
      "main": [
        [
          {
            "node": "Reserve draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve draft": {
      "main": [
        [
          {
            "node": "Needs Gmail draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Gmail draft": {
      "main": [
        [
          {
            "node": "Create Gmail draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Gmail draft": {
      "main": [
        [
          {
            "node": "Record Gmail draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "id": "mailpilotGmailV1"
}
